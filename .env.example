# Buat GitHub OAuth App di: https://github.com/settings/developers
# Homepage URL: https://www.mastercode.my.id
# Authorization callback URL: https://www.mastercode.my.id/api/auth/callback/github

GITHUB_ID=isi_client_id_github
GITHUB_SECRET=isi_client_secret_github

# Generate dengan: openssl rand -base64 32
NEXTAUTH_SECRET=isi_random_secret

# Saat development: http://localhost:3000
# Saat production: https://www.mastercode.my.id
NEXTAUTH_URL=http://localhost:3000

# AI code suggestion (GRATIS) — daftar & buat API key di https://console.groq.com
GROQ_API_KEY=isi_groq_api_key

# KEAMANAN: username GitHub yang boleh login, pisahkan koma kalau lebih dari satu.
# Kosongkan kalau mau semua orang boleh login (mode publik/demo).
ALLOWED_GITHUB_USERS=username_github_kamu

# Live Preview (opsional) — biar tombol "Test" bisa nunjukin website beneran jalan.
# Buat token di: https://vercel.com/account/tokens
VERCEL_TOKEN=isi_vercel_token
# Isi cuma kalau project Vercel kamu di bawah Team, bukan Personal Account.
# Cari di URL dashboard tim: vercel.com/[team-slug]/~/settings -> Team ID
VERCEL_TEAM_ID=

# (Opsional) Kalau project Vercel kamu ada Deployment Protection aktif (Vercel
# Authentication/password), preview URL bakal kena halaman "request access"
# dulu. Cara yang disarankan: isi tokennya LANGSUNG di halaman tiap repo
# (Repository -> Settings -> Live Preview (Vercel)) — soalnya tiap repo bisa
# punya project Vercel & token bypass yang beda-beda.
# Variabel di bawah ini cuma FALLBACK global kalau suatu repo belum diisi
# tokennya lewat UI:
# 1. Buka project di vercel.com -> Settings -> Deployment Protection
# 2. Scroll ke "Protection Bypass for Automation" -> generate secret
# 3. Copy secret-nya ke sini
VERCEL_AUTOMATION_BYPASS_SECRET=

# Live Preview alternatif (opsional) — sama fungsinya kayak Vercel di atas,
# bisa diisi salah satu atau dua-duanya sekaligus. Buat token di:
# https://app.netlify.com/user/applications -> Personal access tokens
NETLIFY_TOKEN=isi_netlify_token

# Supabase (dipakai untuk fitur Survey/Live) — project gratis, lihat README.
# Project URL: dashboard Supabase -> Settings -> API -> Project URL
SUPABASE_URL=isi_url_project_supabase
# Settings -> API -> service_role key (JANGAN dipakai/expose di client!)
SUPABASE_SERVICE_ROLE_KEY=isi_service_role_key
